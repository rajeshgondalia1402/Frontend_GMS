# Base URL the frontend prefixes to every API call.
#   /api                       -> same origin; the Vite dev server proxies it (default, no CORS needed)
#   http://localhost:5000/api  -> call the Node.js API directly (requires CORS enabled on the backend)
VITE_API_BASE_URL=/api

# Where the dev-server proxy forwards /api requests. Ignored in production builds.
VITE_API_PROXY_TARGET=http://localhost:5000
