# Base URL the frontend prefixes to every API call.
#   /api                       -> same origin; the Vite dev server proxies it (default, no CORS needed)
#   http://localhost:5000/api  -> call the Node.js API directly (requires CORS enabled on the backend)
VITE_API_BASE_URL=/api

# Where the dev-server proxy forwards /api requests. Ignored in production builds.
VITE_API_PROXY_TARGET=http://localhost:5000

# Where the public Contact form (`/contact`) posts an enquiry, relative to
# VITE_API_BASE_URL. The API has no such endpoint yet, so this is left blank:
# while it is blank the form tells visitors that delivery is not connected
# rather than reporting a message as sent. Set it (e.g. /contact) to switch the
# form on — see src/services/contactService.ts for the payload it sends.
#VITE_CONTACT_ENQUIRY_PATH=/contact

# Never put an API key or secret in a VITE_ variable: everything prefixed
# VITE_ is shipped to the browser. The 2Factor key lives only in the API's .env.
